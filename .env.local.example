# CHỈ dùng ở server (API route). KHÔNG thêm tiền tố NEXT_PUBLIC_ và KHÔNG commit giá trị thật.
# Lấy tại: Supabase Dashboard > Project Settings > API Keys > service_role / secret key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Mật khẩu quản trị, bắt buộc nhập khi hủy lịch họp. CHỈ dùng ở server.
# KHÔNG thêm tiền tố NEXT_PUBLIC_ và KHÔNG commit giá trị thật.
ADMIN_DELETE_PASSWORD=mat_khau_cua_ban

# Google Calendar API: tự tạo link Google Meet cho cuộc họp ONLINE. CHỈ dùng ở server.
# Xác thực OAuth 2.0 bằng một tài khoản Google trung tâm (OAuth Client + refresh token).
# KHÔNG thêm tiền tố NEXT_PUBLIC_ và KHÔNG commit giá trị thật.
# GOOGLE_CALENDAR_ID là tùy chọn: để trống thì dùng lịch chính ("primary") của tài khoản đó.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
